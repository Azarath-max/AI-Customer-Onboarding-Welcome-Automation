    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-3-flash-preview",
          "mode": "list",
          "cachedResultName": "models/gemini-3-flash-preview"
        },
        "messages": {
          "values": [
            {
              "content": "=Write the welcome email body using ONLY these facts.\n\nCustomer: {{ $json.accountName }}\nContact first name: {{ $json.contactName.split(' ')[0] }}\nProducts purchased: {{ $json.products }}\nCustomer Success Manager (onboarding owner): {{ $json.csm }}\n\nThe email must include: a greeting by first name, a short welcome, a mention of every product listed above, an introduction of the CSM as the person guiding their onboarding, a simple next step (reply to this email with questions or good times to connect), and a friendly closing signed \"The Customer Success Team\"."
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "systemMessage": "=You write customer onboarding welcome emails. Use only the facts you are given. Never invent or mention products, dates, deadlines, people, features, pricing, contract terms, links, meetings, or commitments. Never mention the deal amount. Tone: professional, friendly, conversational, concise, under 150 words. Output only the email body as plain text. No subject line, no markdown, no placeholders."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        1712,
        -80
      ],
      "id": "ff311616-e2a7-4bee-9769-ee29c92bd64b",
      "name": "Draft Welcome Email",
      "credentials": {
        "googlePalmApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const base = $('Validate Required Data').item.json;\nconst j = $input.item.json;\nconst body = String(\n  j.content?.parts?.[0]?.text ?? j.candidates?.[0]?.content?.parts?.[0]?.text ?? j.text ?? ''\n).trim();\n\nconst problems = [];\nconst lower = body.toLowerCase();\nif (body.length < 100) problems.push('Draft empty or too short');\nif (body.length > 1500) problems.push('Draft too long');\nif (!lower.includes(base.contactName.split(' ')[0].toLowerCase())) problems.push('Contact name missing');\nif (!lower.includes(base.csm.toLowerCase())) problems.push('CSM name missing');\nbase.products.split('+').map(p => p.trim().toLowerCase()).filter(Boolean)\n  .forEach(p => { if (!lower.includes(p)) problems.push('Product missing: ' + p); });\nif (/\\$\\s?\\d|\\d+\\s?%|https?:\\/\\//i.test(body)) problems.push('Contains amount, percentage or link');\n\nreturn { json: {\n  ...base,\n  emailSubject: `Welcome to ${base.products} - Next Steps`,\n  emailBody: body,\n  aiValid: problems.length === 0,\n  aiProblems: problems\n}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
