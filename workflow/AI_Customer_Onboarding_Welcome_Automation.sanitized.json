    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $input.item.json;\nconst base = $('Validate Required Data').item.json;\nlet exceptionType, reason, action;\n\nif ($('Mark Email Failed').isExecuted) {\n  exceptionType = 'Gmail send failed';\n  reason = 'The approved email could not be sent. Onboarding Status set to Email Failed.';\n  action = 'Check the Gmail credential and the n8n execution, then re-trigger.';\n} else if ($('Slack Approval Request').isExecuted) {\n  exceptionType = 'Draft rejected';\n  reason = 'The reviewer disapproved the draft. No email was sent.';\n  action = 'Review the customer data, then re-trigger if needed.';\n} else if ($('Check AI Draft').isExecuted) {\n  exceptionType = 'AI draft failed checks';\n  reason = (j.aiProblems || []).join(', ');\n  action = 'Write the welcome email manually or re-trigger.';\n} else if ($('Draft Welcome Email').isExecuted) {\n  exceptionType = 'Gemini failed';\n  reason = 'Gemini did not produce a draft.';\n  action = 'Check the Gemini credential, then re-trigger.';\n} else {\n  exceptionType = 'Missing required data';\n  reason = 'Missing: ' + (j.missingFields || []).join(', ');\n  action = 'Fix the Salesforce record. Saving it again re-triggers the workflow.';\n}\n\nreturn { json: { ...base, exceptionType, reason, action } };"
      },
