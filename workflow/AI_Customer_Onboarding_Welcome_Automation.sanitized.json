    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const opp = $('Get Opportunity').item.json;\nconst c = $input.item.json || {};\nconst acct = c.Account || {};\nconst clean = v => (typeof v === 'string' ? v.trim() : v);\n\nconst data = {\n  opportunityId: opp.Id,\n  opportunityName: clean(opp.Name),\n  amount: opp.Amount,\n  closeDate: opp.CloseDate,\n  products: clean(opp.Products__c),\n  implementationRequired: opp.Implementation_Required__c === true,\n  csm: clean(opp.CSM__c),\n  onboardingStatus: opp.Onboarding_Status__c || 'Not Started',\n  accountId: opp.AccountId,\n  accountName: clean(acct.Name),\n  industry: acct.Industry || null,\n  customerSegment: acct.Customer_Segment__c || null,\n  contactName: clean(c.Name),\n  contactEmail: clean(c.Email),\n};\n\nconst missing = [];\nif (!data.opportunityName) missing.push('Opportunity');\nif (!data.accountName) missing.push('Account');\nif (!data.contactName) missing.push('Contact');\nif (!data.contactEmail) missing.push('Contact email');\nelse if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(data.contactEmail)) missing.push('Valid contact email');\nif (!data.products) missing.push('Products');\nif (!data.csm) missing.push('CSM');\n\nreturn { json: { ...data, missingFields: missing, isValid: missing.length === 0 } };"
      },
